<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="yt-feed.exe"
        Arguments=""
        InstallLocation="C:\Program Files\YT Feed\YT Feed">
    </Installer>
    <PackageInformation
        PackageName="YT Feed"
        PackageDisplayName="YT Feed"
        PublisherName="CN=YT Feed"
        PublisherDisplayName="YT Feed"
        Version="0.1.0.0"
        PackageDescription="Desktop YouTube subscriptions feed">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.ytfeed.app"
                Description="Desktop YouTube subscriptions feed"
                DisplayName="YT Feed"
                ExecutableName="yt-feed.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>YT Feed</DisplayName>
            <PublisherDisplayName>YT Feed</PublisherDisplayName>
            <Description>Desktop YouTube subscriptions feed</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="yt-feed.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
